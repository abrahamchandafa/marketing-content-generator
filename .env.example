PORT=3001
DATABASE_PATH=./data/marketing.db
STORAGE_DIR=./storage

# fixed = procedural SVG beach background (no API key needed)
# ai    = OpenRouter generates a cartoon background image via LLM + image model
BACKGROUND_MODE=fixed

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5