{
  "name": "marketing-content-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @mc/api\" \"npm run dev -w @mc/web\"",
    "dev:api": "npm run dev -w @mc/api",
    "dev:web": "npm run dev -w @mc/web",
    "build": "npm run build -w @mc/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "concurrently": "^9.0.1",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
